[Unit]
Description=printing3 busyprint (source code to PostScript)
Documentation=https://github.com/contester/printing3
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=/etc/sysconfig/printing3-busyprint
User=printing3
Group=printing3
ExecStart=/usr/bin/printing3-busyprint
Restart=on-failure
RestartSec=5

# latex/metafont write their caches and fonts under TEXMFVAR; give them a
# writable home inside the state directory.
StateDirectory=printing3
WorkingDirectory=/var/lib/printing3
Environment=HOME=/var/lib/printing3
Environment=TEXMFVAR=/var/lib/printing3/texmf-var
Environment=TEXMFHOME=/var/lib/printing3/texmf

# Contestant-supplied text goes through pygmentize and latex.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
